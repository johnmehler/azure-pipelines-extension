{
  "name": "pipeline-manager-azure-devops",
  "displayName": "Pipeline Manager for Azure DevOps",
  "description": "Browse, run, and inspect Azure DevOps pipelines from VS Code.",
  "icon": "media/icon.png",
  "version": "0.1.1",
  "publisher": "JohnMehler",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnmehler/azure-pipelines-extension.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:azure-pipelines",
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/api.js && node --check src/git.js && node --check src/helpers.js && node --check src/logViewer.js && node --check src/yamlSupport.js && node --check src/providers.js && node --check src/extension.js",
    "build": "esbuild ./src/extension.js --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run check && npm run build && npm test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azure-pipelines",
          "title": "Azure Pipelines",
          "icon": "media/azure-pipelines.svg"
        }
      ]
    },
    "views": {
      "azure-pipelines": [
        {
          "id": "azure-pipelines.pipelines",
          "name": "Pipelines"
        },
        {
          "id": "azure-pipelines.currentBranch",
          "name": "Current Branch"
        },
        {
          "id": "azure-pipelines.settings",
          "name": "Library"
        }
      ]
    },
    "commands": [
      {
        "command": "azure-pipelines.configure",
        "title": "Configure Azure DevOps Connection",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.switchConnection",
        "title": "Switch Azure DevOps Connection",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.disconnect",
        "title": "Disconnect Azure DevOps",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.refreshSchema",
        "title": "Download Organization YAML Schema",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.showPinned",
        "title": "Show Pinned Pipelines",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.refresh",
        "title": "Refresh",
        "category": "Azure Pipelines",
        "icon": "$(refresh)"
      },
      {
        "command": "azure-pipelines.openRun",
        "title": "Open Run in Browser",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.openDefinition",
        "title": "Open Pipeline YAML",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.openEnvironment",
        "title": "Open Environment in Browser",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addEnvironment",
        "title": "Create Environment",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.updateEnvironment",
        "title": "Edit Environment",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteEnvironment",
        "title": "Delete Environment",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addVariableGroup",
        "title": "Create Variable Group",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.updateVariableGroup",
        "title": "Rename Variable Group",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteVariableGroup",
        "title": "Delete Variable Group",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.queuePipeline",
        "title": "Run Pipeline",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.togglePipelineQueue",
        "title": "Pause / Resume Pipeline",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.cancelRun",
        "title": "Cancel Run",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteRun",
        "title": "Delete Run",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.retryRun",
        "title": "Retry Run",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.retryStage",
        "title": "Retry Stage",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.retryJob",
        "title": "Retry Failed Jobs in Stage",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.openLogs",
        "title": "Open Logs",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.openLogsInBrowser",
        "title": "Open Step in Browser",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.downloadArtifact",
        "title": "Download Pipeline Artifact",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.approveApproval",
        "title": "Approve Pipeline Gate",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.rejectApproval",
        "title": "Reject Pipeline Gate",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.pinPipeline",
        "title": "Pin Pipeline",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.unpinPipeline",
        "title": "Unpin Pipeline",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addVariable",
        "title": "Add Library Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.updateVariable",
        "title": "Update Library Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteVariable",
        "title": "Delete Library Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.copyVariable",
        "title": "Copy Variable Name",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.copyVariableValue",
        "title": "Copy Variable Value",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addPipelineVariable",
        "title": "Add Pipeline Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.updatePipelineVariable",
        "title": "Update Pipeline Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deletePipelineVariable",
        "title": "Delete Pipeline Variable",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addSecureFile",
        "title": "Upload Secure File",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteSecureFile",
        "title": "Delete Secure File",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.addServiceConnection",
        "title": "Create Generic Service Connection",
        "category": "Azure Pipelines"
      },
      {
        "command": "azure-pipelines.deleteServiceConnection",
        "title": "Delete Service Connection",
        "category": "Azure Pipelines"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azure-pipelines.refresh",
          "icon": "$(refresh)",
          "group": "navigation",
          "when": "view == azure-pipelines.pipelines || view == azure-pipelines.currentBranch || view == azure-pipelines.settings"
        }
      ],
      "view/item/context": [
        {
          "command": "azure-pipelines.queuePipeline",
          "when": "viewItem == azurePipeline || viewItem == azurePipelinePinned"
        },
        {
          "command": "azure-pipelines.queuePipeline",
          "group": "inline",
          "icon": "$(play)",
          "when": "viewItem == azurePipeline || viewItem == azurePipelinePinned"
        },
        {
          "command": "azure-pipelines.togglePipelineQueue",
          "when": "viewItem == azurePipeline || viewItem == azurePipelinePinned"
        },
        {
          "command": "azure-pipelines.openDefinition",
          "when": "viewItem == azurePipeline || viewItem == azurePipelinePinned"
        },
        {
          "command": "azure-pipelines.openEnvironment",
          "when": "viewItem == azureEnvironment"
        },
        {
          "command": "azure-pipelines.addEnvironment",
          "when": "viewItem == azureEnvironments"
        },
        {
          "command": "azure-pipelines.updateEnvironment",
          "when": "viewItem == azureEnvironment"
        },
        {
          "command": "azure-pipelines.deleteEnvironment",
          "when": "viewItem == azureEnvironment"
        },
        {
          "command": "azure-pipelines.pinPipeline",
          "when": "viewItem == azurePipeline"
        },
        {
          "command": "azure-pipelines.unpinPipeline",
          "when": "viewItem == azurePipelinePinned"
        },
        {
          "command": "azure-pipelines.openRun",
          "when": "viewItem =~ /azurePipelineRun/"
        },
        {
          "command": "azure-pipelines.cancelRun",
          "when": "viewItem == azurePipelineRunActive"
        },
        {
          "command": "azure-pipelines.cancelRun",
          "group": "inline",
          "icon": "$(stop-circle)",
          "when": "viewItem == azurePipelineRunActive"
        },
        {
          "command": "azure-pipelines.deleteRun",
          "when": "viewItem == azurePipelineRunCompleted"
        },
        {
          "command": "azure-pipelines.retryRun",
          "when": "viewItem == azurePipelineRunCompleted"
        },
        {
          "command": "azure-pipelines.retryStage",
          "when": "viewItem == azurePipelineStageRetry"
        },
        {
          "command": "azure-pipelines.retryJob",
          "when": "viewItem == azurePipelineJobRetry"
        },
        {
          "command": "azure-pipelines.downloadArtifact",
          "when": "viewItem == azurePipelineArtifact"
        },
        {
          "command": "azure-pipelines.openLogs",
          "when": "viewItem == azurePipelineLog"
        },
        {
          "command": "azure-pipelines.openLogs",
          "group": "inline",
          "icon": "$(output)",
          "when": "viewItem == azurePipelineLog"
        },
        {
          "command": "azure-pipelines.openLogsInBrowser",
          "when": "viewItem == azurePipelineLog"
        },
        {
          "command": "azure-pipelines.addVariable",
          "when": "viewItem == azureVariableGroup"
        },
        {
          "command": "azure-pipelines.updateVariableGroup",
          "when": "viewItem == azureVariableGroup"
        },
        {
          "command": "azure-pipelines.deleteVariableGroup",
          "when": "viewItem == azureVariableGroup"
        },
        {
          "command": "azure-pipelines.addVariableGroup",
          "when": "viewItem == azureVariableGroups"
        },
        {
          "command": "azure-pipelines.updateVariable",
          "when": "viewItem =~ /azureLibraryVariable/"
        },
        {
          "command": "azure-pipelines.deleteVariable",
          "when": "viewItem =~ /azureLibraryVariable/"
        },
        {
          "command": "azure-pipelines.copyVariable",
          "when": "viewItem =~ /azureLibraryVariable/"
        },
        {
          "command": "azure-pipelines.copyVariableValue",
          "when": "viewItem == azureLibraryVariable"
        },
        {
          "command": "azure-pipelines.approveApproval",
          "when": "viewItem == azurePipelineApproval"
        },
        {
          "command": "azure-pipelines.rejectApproval",
          "when": "viewItem == azurePipelineApproval"
        },
        {
          "command": "azure-pipelines.addPipelineVariable",
          "when": "viewItem == azurePipelineDefinitionVariables"
        },
        {
          "command": "azure-pipelines.updatePipelineVariable",
          "when": "viewItem =~ /azurePipelineVariable/"
        },
        {
          "command": "azure-pipelines.deletePipelineVariable",
          "when": "viewItem =~ /azurePipelineVariable/"
        },
        {
          "command": "azure-pipelines.copyVariable",
          "when": "viewItem =~ /azurePipelineVariable/"
        },
        {
          "command": "azure-pipelines.copyVariableValue",
          "when": "viewItem == azurePipelineVariable"
        },
        {
          "command": "azure-pipelines.addSecureFile",
          "when": "viewItem == azureSecureFiles"
        },
        {
          "command": "azure-pipelines.deleteSecureFile",
          "when": "viewItem == azureSecureFile"
        },
        {
          "command": "azure-pipelines.addServiceConnection",
          "when": "viewItem == azureServiceConnections"
        },
        {
          "command": "azure-pipelines.deleteServiceConnection",
          "when": "viewItem == azureServiceConnection"
        }
      ]
    },
    "configuration": {
      "title": "Azure Pipelines",
      "properties": {
        "azure-pipelines.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization name (the segment in https://dev.azure.com/{organization})."
        },
        "azure-pipelines.project": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps project name or ID."
        },
        "azure-pipelines.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Server collection URL for on-premises deployments, e.g. https://ado.example.com/tfs/DefaultCollection. Leave empty for Azure DevOps Services."
        },
        "azure-pipelines.apiVersion": {
          "type": "string",
          "default": "7.1",
          "description": "Azure DevOps REST API version. Set this to a version supported by your Azure DevOps Server."
        },
        "azure-pipelines.authMethod": {
          "type": "string",
          "enum": [
            "microsoft",
            "pat"
          ],
          "default": "pat",
          "description": "Authentication method for Azure DevOps REST API requests."
        },
        "azure-pipelines.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Automatic refresh interval in seconds (minimum 30). Set to 0 to disable polling."
        },
        "azure-pipelines.customSchemaFile": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative path to the organization-specific Azure Pipelines YAML schema."
        }
      }
    },
    "configurationDefaults": {
      "json.schemas": [
        {
          "url": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
          "fileMatch": [
            "task.json",
            "**/task.json"
          ]
        }
      ],
      "yaml.schemas": {
        "https://raw.githubusercontent.com/microsoft/azure-pipelines-vscode/main/service-schema.json": [
          "azure-pipelines.yml",
          "azure-pipelines.yaml",
          "**/azure-pipelines.yml",
          "**/azure-pipelines.yaml",
          ".azure-pipelines/**/*.yml",
          ".azure-pipelines/**/*.yaml",
          "**/.azure-pipelines/**/*.yml",
          "**/.azure-pipelines/**/*.yaml",
          "**/azure-pipelines/**/*.yml",
          "**/azure-pipelines/**/*.yaml",
          "**/.pipelines/**/*.yml",
          "**/.pipelines/**/*.yaml",
          "vsts-ci.yml",
          "vsts-ci.yaml",
          ".vsts-ci.yml",
          ".vsts-ci.yaml",
          "**/*.azure-pipelines.yml",
          "**/*.azure-pipelines.yaml"
        ]
      }
    },
    "grammars": [
      {
        "scopeName": "source.azure-pipelines.expressions",
        "path": "./syntaxes/azure-pipelines-expressions.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
